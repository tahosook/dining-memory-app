{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "dining-memory-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:release": "bash ./scripts/build-android-release.sh",
    "build:android:release:full": "BUILD_ANDROID_ARCHITECTURES=armeabi-v7a,arm64-v8a,x86,x86_64 BUILD_ANDROID_VARIANT_LABEL=release-full bash ./scripts/build-android-release.sh",
    "build:android:debug": "BUILD_ANDROID_TASK=assembleDebug BUILD_ANDROID_OUTPUT_TYPE=debug BUILD_ANDROID_VARIANT_LABEL=debug BUILD_ANDROID_ARCHITECTURES= bash ./scripts/build-android-release.sh",
    "install:android:release": "bash ./scripts/install-android-artifact.sh",
    "install:android:debug": "INSTALL_ANDROID_VARIANT=debug bash ./scripts/install-android-artifact.sh",
    "release:android": "npm run build:android:release && npm run install:android:release",
    "publish:model": "python3 ./scripts/publish_mediapipe_model.py",
    "android:gradle": "cd android && ./gradlew",
    "clean": "rm -rf node_modules package-lock.json yarn.lock && echo 'cleaned node_modules and lockfiles'",
    "install:fresh": "npm run clean && npm install",
    "check:deps": "knip --include dependencies,unlisted --no-config-hints",
    "check:docs": "node ./scripts/check-docs.cjs",
    "check:react-versions": "node ./scripts/check-react-versions.cjs",
    "check:expo-doctor": "npx --yes expo-doctor",
    "test": "jest",
    "test:coverage": "npm test -- --coverage",
    "test:python": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "test:python:fast": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "lint": "eslint App.tsx index.ts src tests --cache --cache-location .eslintcache",
    "lint:fix": "eslint App.tsx index.ts src tests --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"App.tsx\" \"index.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"App.tsx\" \"index.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "verify:quick": "npm run type-check && npm run lint && jest --onlyChanged --passWithNoTests",
    "verify:pr-gates": "bash ./scripts/verify-pr-gates.sh",
    "verify": "npm run verify:pr-gates && npm run check:react-versions && npm run check:deps && npm run check:docs && npm run format:check && npm run lint && npm run type-check && npm run check:expo-doctor && npm test && npm run test:python:fast"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "^3.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "llama.rn": "^0.12.9",
    "piexifjs": "^1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "react-native-zip-archive": "^9.5.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.1",
    "jest-expo": "~58.0.13",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "react-native-web": "~0.21.4",
    "react-test-renderer": "19.3.0",
    "semver": "^7.8.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@bam.tech/react-native-image-resizer"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "overrides": {
    "eslint-plugin-ft-flow": "3.0.11",
    "@expo/metro-config": {
      "postcss": "8.5.14"
    },
    "jest-environment-jsdom": {
      "jsdom": "23.2.0"
    },
    "uuid": "11.1.1"
  },
  "private": true,
  "allowScripts": {
    "llama.rn@0.12.9": true,
    "fsevents@2.3.3": true
  }
}
