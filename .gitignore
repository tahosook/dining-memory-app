# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native & Signing (keystores and private certificates are strictly excluded)
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# Generated native folders (iOS remains managed by Expo; Android is Bare Workflow)
/ios
ios/build/

# Android native project artifacts & local configs (managed in android/.gitignore)
# See android/.gitignore for android/build, .gradle, local.properties, ggml-hexagon, etc.

# Build artifacts (APKs and outputs)
build*.apk
*.apk
artifacts/

# Metro / Debug / Coverage
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
coverage/

# Local env files
.env
.env.local
.env*.local

# TypeScript
*.tsbuildinfo

# OS / IDE
.DS_Store
.vscode/
.idea/
.eslintcache
.gradle/
.gradle-home/

# MediaPipe labeling loop runtime artifacts
state/labeling/
state/mediapipe-dataset/
state/mediapipe_labeling_runs/
